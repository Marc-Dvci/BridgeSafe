# BridgeSafe — testnet configuration template.
#
#   cp .env.example .env && scripts/new-testnet-keys.sh
#
# .env is gitignored. Never put a key that holds real value in this file.
# This project is testnet-only; scripts/check-secrets.sh rejects mainnet
# endpoints. See SECURITY.md.

# ---------------------------------------------------------------------------
# Keys — generated by scripts/new-testnet-keys.sh, do not paste your own
# ---------------------------------------------------------------------------
# Funded Coston2 account that deploys contracts and registers the extension.
DEPLOYMENT_PRIVATE_KEY=
# Address derived from DEPLOYMENT_PRIVATE_KEY. Owns the contracts and is the
# default sole governance signer for the TEE machine registration.
INITIAL_OWNER=
# Key the local ext-proxy signs relayed instructions with.
PROXY_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Flare chain — Coston2 testnet (chain ID 114)
# ---------------------------------------------------------------------------
# Do not add a bare `CHAIN` variable here. Foundry auto-loads this .env for any
# forge or cast command run from the repo root, and it reads $CHAIN as if it were
# `--chain`. Foundry's name for this network is `flare-coston2`, so `CHAIN=coston2`
# makes every such command fail with "invalid value 'coston2' for '--chain'".
# The extension tooling has its own CHAIN, set by extension/scripts/use-chain.sh
# in extension/.env.coston2 — it does not read this file.
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114
ADDRESSES_FILE=./config/coston2/deployed-addresses.json
COSTON2_EXPLORER=https://coston2-explorer.flare.network

# ---------------------------------------------------------------------------
# FCC / TEE
# ---------------------------------------------------------------------------
# false on a real chain: enables attestation checks.
LOCAL_MODE=false
# true = simulated attestation (MODE=1). Set false only with a real GCP
# Confidential Space VM. See docs/threat-model.md for what this changes.
SIMULATED_TEE=true
# Flare's FTDC proxy for Coston2. Not ours; do not change.
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
# Public HTTPS URL for OUR ext-proxy (host port 6674). Filled in by
# scripts/tunnel.sh. Read SECURITY.md section 1.2 before running it.
EXT_PROXY_URL=
# Extension language for the built image (go is reproducible bit-for-bit).
LANGUAGE=go

# ---------------------------------------------------------------------------
# Local C-chain indexer — replaces Flare's credentialed indexer DB.
# MySQL is published to 127.0.0.1 only.
# ---------------------------------------------------------------------------
INDEXER_DB_HOST=127.0.0.1
INDEXER_DB_PORT=3306
INDEXER_DB_NAME=flare_ftso_indexer
INDEXER_DB_USER=indexer
# Local-only database password. Generated by scripts/new-testnet-keys.sh if empty.
INDEXER_DB_PASSWORD=

# ---------------------------------------------------------------------------
# XRPL Testnet
# ---------------------------------------------------------------------------
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
XRPL_EXPLORER=https://testnet.xrpl.org
XRPL_FAUCET=https://faucet.altnet.rippletest.net/accounts

# ---------------------------------------------------------------------------
# FDC — verifier and Data Availability layer
# ---------------------------------------------------------------------------
VERIFIER_URL_TESTNET=https://fdc-verifiers-testnet.flare.network
# Public rate-limited testing key published in Flare's own docs. Not a secret.
VERIFIER_API_KEY_TESTNET=00000000-0000-0000-0000-000000000000
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network

# ---------------------------------------------------------------------------
# Deployed BridgeSafe addresses — written by scripts/deploy-coston2.sh
# ---------------------------------------------------------------------------
BRIDGESAFE_CONTROLLER=
BRIDGESAFE_FDC_VERIFIER=
EXTENSION_ID=

# Pinned upstream versions for the BridgeSafe stack.
#
# Referenced by infra/docker-compose.yml. Changing a value here is the only way
# an upstream component should move, so a rebuild cannot silently pick up
# different code.

# flare-foundation/flare-system-c-chain-indexer, built from source by compose.
# Pin to a tag or commit rather than a branch before any long-lived deployment;
# "main" is convenient during the hackathon and is the one loose end here.
INDEXER_REF=main

# MySQL for the indexer database.
MYSQL_IMAGE=mysql:8.4
